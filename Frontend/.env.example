# Copy to .env.local
#
# Mock demo (no backend). Set false when talking to FastAPI.
VITE_USE_MOCK=false

# Absolute API origin for local API-without-proxy, or leave unset and use Vite /api proxy.
# Production Docker leaves this empty so the SPA calls same-origin /api.
VITE_API_TARGET=http://localhost:8000

# NOTE: Mistral key belongs in Backend/.env only — never VITE_*.

