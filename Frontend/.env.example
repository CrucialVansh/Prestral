# Copy to .env.local
#
# Serve the bundled demo deck instead of calling the backend.
# Keep this true until the backend pipeline is returning real deck JSON —
# it is also the fallback demo path if the pipeline breaks on the day.
VITE_USE_MOCK=true

# Where the FastAPI backend lives (used by the Vite dev proxy).
VITE_API_TARGET=http://localhost:8000

# NOTE: the Mistral API key belongs to the BACKEND only (Backend/.env).
# Never put it in a VITE_* variable — anything prefixed VITE_ is inlined
# into the JS bundle and shipped to every visitor in plain text.
